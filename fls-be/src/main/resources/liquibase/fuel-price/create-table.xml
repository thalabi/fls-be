<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
						http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
						http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

	<changeSet author="Tarif Halabi (generated)" id="fuel-price-create-table">
        <createTable tableName="fuel_price">
        
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="fuel_price_pkey"/>
            </column>
            <column name="lk" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
            
            <column name="airport" type="VARCHAR(4)">
                <constraints nullable="false"/>
			</column>            
            <column name="fbo" type="VARCHAR(256)"/>
            <column name="date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            
            <column name="price_per_litre" type="numeric(4, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(4000)"/>
            
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="lk" constraintName="fuel_price_lk_key" tableName="fuel_price"/>
	</changeSet>
</databaseChangeLog>
