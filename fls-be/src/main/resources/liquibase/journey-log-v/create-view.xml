<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
	xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
						http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
						http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

	<changeSet author="Tarif Halabi (generated)" id="journey-log-v">

 		<sql>
		<![CDATA[
		drop view if exists journey_log_v;
		]]>         
		</sql>

    	<createView viewName="journey_log_v">
			<![CDATA[
			with initial_tsn as (
			         select ap.registration,
			            ap.initial_tsn as tsn
			           from ac_parameters ap
			)
			select jl.*, it.tsn + sum(airtime) over (order by "date" rows unbounded preceding) as tsn
			  from journey_log jl
			  join initial_tsn it on jl.registration = it.registration
   			]]>
		</createView>

    </changeSet>

</databaseChangeLog>